/thipcsl/add-*.ts
/thipcsl/check-*.ts
/thipcsl/clean-*.ts
/thipcsl/cleanup-*.ts
/thipcsl/count-*.ts
/thipcsl/create-*.ts
/thipcsl/create_*.ts
/thipcsl/debug-*.ts
/thipcsl/debug_*.ts
/thipcsl/debug_*.js
/thipcsl/delete-*.ts
/thipcsl/disable-*.ts
/thipcsl/end-*.ts
/thipcsl/export-*.ts
/thipcsl/find-*.ts
/thipcsl/fix-*.ts
/thipcsl/fix-*.js
/thipcsl/list-*.ts
/thipcsl/migrate-*.ts
/thipcsl/quick-*.ts
/thipcsl/recalc-*.ts
/thipcsl/recalc-*.js
/thipcsl/recreate-*.ts
/thipcsl/remove-*.ts
/thipcsl/reproduce-*.ts
